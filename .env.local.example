# ─── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Required in production: @auth/core checks AUTH_TRUST_HOST (or AUTH_URL),
# NOT NEXTAUTH_URL, to set trustHost. Without it, assertConfig throws UntrustedHost→"Configuration".
AUTH_TRUST_HOST=true

# ─── GitHub OAuth App ────────────────────────────────────────────────────────
# Create an OAuth App at: https://github.com/settings/developers
# Callback URL (dev):  http://localhost:3000/api/auth/callback/github
# Callback URL (prod): https://yourdomain.com/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ─── App URL ────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
